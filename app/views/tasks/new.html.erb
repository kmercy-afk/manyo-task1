<h1>New Task Page</h1>

<% if @task.errors.any? %>
  <div style="color: red; background-color: #ffe6e6; padding: 10px; margin-bottom: 15px; border: 1px solid red; border-radius: 5px;">
    <h3 style="margin-top: 0;">Please fix the following errors:</h3>
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @task, local: true do |form| %>
  <div>
    <%= form.label :title, 'Title Title', id: 'title-title' %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, 'Content', id: 'content' %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.submit 'Create Task', id: 'create-task' %>
  </div>
<% end %>

<%= link_to 'Back', tasks_path, id: 'back' %>