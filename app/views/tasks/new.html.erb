<h1><%= t('views.tasks.new.title') %></h1>

<% if @task.errors.any? %>
  <div style="color: red; background: #ffe6e6; padding: 15px; margin-bottom: 20px; border: 1px solid red; border-radius: 4px;">
    <strong><%= pluralize(@task.errors.count, t('errors.messages.error', count: @task.errors.count)) %>:</strong>
    <ul style="margin: 10px 0 0 20px;">
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @task, local: true do |form| %>
  <div>
    <%= form.label :title, t('activerecord.attributes.task.title'), id: 'title-title' %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, t('activerecord.attributes.task.content'), id: 'content' %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.submit t('helpers.submit.create'), id: 'create-task' %>
  </div>
<% end %>

<%= link_to t('views.tasks.new.back'), tasks_path, id: 'back' %>