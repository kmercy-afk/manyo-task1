<h1 class="tasks-index-page">Tasks Index Page</h1>

<% if @tasks.any? %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Content</th>
        <th>Created at</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= task.title %></td>
          <td><%= task.content %></td>
          <td><%= task.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= link_to 'Show', task, class: 'show-task' %></td>
          <td><%= link_to 'Edit', edit_task_path(task), class: 'edit-task' %></td>
          <td><%= link_to 'Destroy', task, method: :delete, data: { confirm: 'Are you sure?' }, class: 'destroy-task' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No tasks yet — create one!</p>
<% end %>

<%= link_to 'New Task', new_task_path, id: 'new-task' %>