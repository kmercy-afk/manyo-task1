<h1><%= t('views.tasks.show.title') %></h1>

<div>
  <strong id="title-title"><%= t('activerecord.attributes.task.title') %>:</strong>
  <%= @task.title %>
</div>

<div>
  <strong id="content"><%= t('activerecord.attributes.task.content') %>:</strong>
  <%= @task.content %>
</div>

<div>
  <strong id="created-at"><%= t('activerecord.attributes.task.created_at') %>:</strong>
  <%= @task.created_at.in_time_zone.strftime("%Y年%m月%d日 %H:%M") %>
</div>

<%= link_to t('views.tasks.edit.title'), edit_task_path(@task), id: 'edit-task' %>
<%= link_to t('views.tasks.show.back'), tasks_path, id: 'back' %>