<!DOCTYPE html>
<html>
  <head>
    <title>CdpWebManyoTask</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
  <nav>
  <ul>
    <li><%= link_to t('views.tasks.index.title'), tasks_path, id: 'tasks-index' %></li>
    <li><%= link_to t('views.tasks.new.title'), new_task_path, id: 'new-task' %></li>
  </ul>
</nav>

<body>
<% if notice %>
  <div style="color: green; background: #e6ffe6; padding: 10px; margin: 10px 0; border-radius: 4px;">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div style="color: red; background: #ffe6e6; padding: 10px; margin: 10px 0; border-radius: 4px;">
    <%= alert %>
  </div>
<% end %>

<%= yield %>
</body>